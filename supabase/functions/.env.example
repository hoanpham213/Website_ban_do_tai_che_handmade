# Biến cho Edge Functions khi chạy thử ở máy (supabase functions serve --env-file).
# Trên Supabase thật: dùng `supabase secrets set TEN=gia_tri`. KHÔNG commit file .env thật.
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY do Supabase tự cấp.

ALLOWED_ORIGIN=http://localhost:5173

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

PAYMENT_PROVIDER=
PAYMENT_MERCHANT_ID=
PAYMENT_SECRET=
PAYMENT_RETURN_URL=http://localhost:5173/order.html
