# Sao chép thành .env rồi điền giá trị từ Supabase Dashboard > Project Settings > API Keys.
# Mọi biến VITE_ đều bị đưa vào mã chạy trên trình duyệt => CHỈ đặt khóa công khai ở đây.
# TUYỆT ĐỐI không đặt service_role key / secret key vào file này.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
