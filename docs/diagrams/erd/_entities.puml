' Định nghĩa bảng dùng chung cho ERD chi tiết
' Ký hiệu: * = NOT NULL, <<PK>> khóa chính, <<FK>> khóa ngoại, <<UQ>> duy nhất
' Bảng có "+ timestamps" có thêm created_at, updated_at

package "Người dùng" {
entity "roles" as roles {
  * id : SMALLINT <<PK>>
  --
  * code : VARCHAR(20) <<UQ>>
  * name : VARCHAR(50)
}
entity "users" as users {
  * id : BIGINT <<PK>>
  --
  * role_id : SMALLINT <<FK>>
  * email : VARCHAR(255) <<UQ>>
  * password_hash : VARCHAR(255)
  * full_name : VARCHAR(100)
  phone : VARCHAR(20)
  * status : VARCHAR(10)
  last_login_at : DATETIME
  + timestamps
}
entity "addresses" as addresses {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK>>
  * recipient_name : VARCHAR(100)
  * recipient_phone : VARCHAR(20)
  * province : VARCHAR(100)
  * ward : VARCHAR(100)
  * street_address : VARCHAR(255)
  * is_default : BOOLEAN
  + timestamps
}
}

package "Sản phẩm" {
entity "categories" as categories {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100) <<UQ>>
  * slug : VARCHAR(120) <<UQ>>
  description : TEXT
  * is_active : BOOLEAN
  * sort_order : INT
  + timestamps
}
entity "attributes" as attributes {
  * id : BIGINT <<PK>>
  --
  * code : VARCHAR(50) <<UQ>>
  * name : VARCHAR(100)
  * data_type : VARCHAR(10)
  unit : VARCHAR(20)
  * is_multi_value : BOOLEAN
  + timestamps
}
entity "attribute_options" as attribute_options {
  * id : BIGINT <<PK>>
  --
  * attribute_id : BIGINT <<FK>>
  * value : VARCHAR(100)
  * sort_order : INT
  UQ (attribute_id, value)
}
entity "category_attributes" as category_attributes {
  * category_id : BIGINT <<PK, FK>>
  * attribute_id : BIGINT <<PK, FK>>
  --
  * is_required : BOOLEAN
  * is_filterable : BOOLEAN
  * sort_order : INT
}
entity "products" as products {
  * id : BIGINT <<PK>>
  --
  * category_id : BIGINT <<FK>>
  * name : VARCHAR(200)
  * slug : VARCHAR(220) <<UQ>>
  description : TEXT
  origin_story : TEXT
  * price : DECIMAL(12,0)
  * sale_type : VARCHAR(10)
  * status : VARCHAR(10)
  + timestamps
}
entity "product_attribute_values" as pav {
  * id : BIGINT <<PK>>
  --
  * product_id : BIGINT <<FK>>
  * attribute_id : BIGINT <<FK>>
  option_id : BIGINT <<FK>>
  value_number : DECIMAL(10,2)
  value_text : VARCHAR(255)
  UQ (product_id, attribute_id, option_id)
}
entity "product_images" as product_images {
  * id : BIGINT <<PK>>
  --
  * product_id : BIGINT <<FK>>
  * image_url : VARCHAR(500)
  alt_text : VARCHAR(255)
  * sort_order : INT
  * is_primary : BOOLEAN
}
entity "materials" as materials {
  * id : BIGINT <<PK>>
  --
  * name : VARCHAR(100) <<UQ>>
  description : TEXT
  + timestamps
}
entity "product_materials" as product_materials {
  * product_id : BIGINT <<PK, FK>>
  * material_id : BIGINT <<PK, FK>>
  --
  * weight_grams : INT
}
}

package "Kho" {
entity "inventories" as inventories {
  * product_id : BIGINT <<PK, FK>>
  --
  * on_hand : INT
  * reserved : INT
  * updated_at : DATETIME
}
entity "inventory_transactions" as inventory_transactions {
  * id : BIGINT <<PK>>
  --
  * product_id : BIGINT <<FK>>
  * type : VARCHAR(10)
  * quantity : INT
  order_id : BIGINT <<FK>>
  created_by : BIGINT <<FK>>
  note : VARCHAR(255)
  * created_at : DATETIME
}
}

package "Mua hàng" {
entity "carts" as carts {
  * id : BIGINT <<PK>>
  --
  * user_id : BIGINT <<FK, UQ>>
  + timestamps
}
entity "cart_items" as cart_items {
  * id : BIGINT <<PK>>
  --
  * cart_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * quantity : INT
  * added_at : DATETIME
  UQ (cart_id, product_id)
}
entity "orders" as orders {
  * id : BIGINT <<PK>>
  --
  * order_code : VARCHAR(20) <<UQ>>
  * user_id : BIGINT <<FK>>
  * status : VARCHAR(15)
  * recipient_name : VARCHAR(100)
  * recipient_phone : VARCHAR(20)
  * ship_province : VARCHAR(100)
  * ship_ward : VARCHAR(100)
  * ship_street_address : VARCHAR(255)
  customer_note : VARCHAR(500)
  * subtotal : DECIMAL(12,0)
  * shipping_fee : DECIMAL(12,0)
  * total_amount : DECIMAL(12,0)
  payment_deadline : DATETIME
  cancel_reason : VARCHAR(255)
  + timestamps
}
entity "order_items" as order_items {
  * id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK>>
  * product_id : BIGINT <<FK>>
  * product_name : VARCHAR(200)
  * unit_price : DECIMAL(12,0)
  * quantity : INT
  * reused_weight_grams : INT
  UQ (order_id, product_id)
}
entity "order_status_histories" as osh {
  * id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK>>
  from_status : VARCHAR(15)
  * to_status : VARCHAR(15)
  changed_by : BIGINT <<FK>>
  note : VARCHAR(255)
  * created_at : DATETIME
}
entity "payments" as payments {
  * id : BIGINT <<PK>>
  --
  * order_id : BIGINT <<FK, UQ>>
  * method : VARCHAR(10)
  provider : VARCHAR(30)
  * amount : DECIMAL(12,0)
  * status : VARCHAR(10)
  transaction_ref : VARCHAR(100) <<UQ>>
  paid_at : DATETIME
  refunded_at : DATETIME
  provider_response : TEXT
  + timestamps
}
}

package "Hậu mãi và chatbot" {
entity "reviews" as reviews {
  * id : BIGINT <<PK>>
  --
  * order_item_id : BIGINT <<FK, UQ>>
  * rating : TINYINT
  comment : TEXT
  * is_visible : BOOLEAN
  + timestamps
}
entity "knowledge_entries" as knowledge_entries {
  * id : BIGINT <<PK>>
  --
  * type : VARCHAR(10)
  * title : VARCHAR(255)
  * content : TEXT
  * is_active : BOOLEAN
  * sort_order : INT
  updated_by : BIGINT <<FK>>
  + timestamps
}
entity "chat_conversations\n(tùy chọn)" as chat_conversations {
  * id : BIGINT <<PK>>
  --
  user_id : BIGINT <<FK>>
  * created_at : DATETIME
}
entity "chat_messages\n(tùy chọn)" as chat_messages {
  * id : BIGINT <<PK>>
  --
  * conversation_id : BIGINT <<FK>>
  * role : VARCHAR(10)
  * content : TEXT
  tool_name : VARCHAR(50)
  * created_at : DATETIME
}
}
